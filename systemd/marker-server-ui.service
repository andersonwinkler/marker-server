[Unit]
Description=Marker browser UI (proxies marker-server API)
Wants=network-online.target marker-server-api.service
After=network-online.target marker-server-api.service

[Service]
Type=simple
User=marker
Group=marker
WorkingDirectory=/opt/marker-server/0.1.0
Environment=MARKER_SERVER_CONFIG=/opt/marker-server/0.1.0/config.json
ExecStart=/opt/marker-server/0.1.0/bin/run-ui.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

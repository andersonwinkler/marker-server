# Example httpd reverse proxy for marker-server UI + API.
# Copy to /etc/httpd/conf.d/marker-proxy.conf and adjust Require rules.
#
# UI:  /marker/      → 127.0.0.1:8002
# API: /marker-api/  → 127.0.0.1:8001
ProxyRequests Off
ProxyPreserveHost Off

# Transfer timeouts only (upload / streaming result). Conversion is async; a
# progress stall fails the job and kills the worker so the queue continues.
Timeout 21600
ProxyTimeout 21600

# Reject oversized uploads before they reach uvicorn (match runtime.max_upload_bytes).
LimitRequestBody 536870912

RedirectMatch ^/marker$ /marker/
RedirectMatch ^/marker-api$ /marker-api/

# UI page is public; it stores auth.api_key in the browser and forwards Bearer.
# Keep /marker/ on trusted networks (and/or add your own AuthType here).
<Location /marker/>
    LimitRequestBody 536870912
    <RequireAny>
        Require ip 127.0.0.0/8
        Require ip ::1
        Require ip 192.168.0.0/16
        Require ip 10.0.0.0/8
        Require ip 100.64.0.0/10
    </RequireAny>
</Location>

<Location /marker-api/>
    LimitRequestBody 536870912
    <RequireAny>
        Require ip 127.0.0.0/8
        Require ip ::1
        Require ip 192.168.0.0/16
        Require ip 10.0.0.0/8
        Require ip 100.64.0.0/10
    </RequireAny>
</Location>

# UI derives the /marker prefix from location.pathname (no fetch rewrite).
<Location /marker>
</Location>

ProxyPass        "/marker-api/" "http://127.0.0.1:8001/" timeout=21600
ProxyPassReverse "/marker-api/" "http://127.0.0.1:8001/"

ProxyPass        "/marker/" "http://127.0.0.1:8002/" timeout=21600
ProxyPassReverse "/marker/" "http://127.0.0.1:8002/"
